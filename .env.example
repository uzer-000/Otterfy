# Database (Neon PostgreSQL; keep TLS enabled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth — generate a unique value with: npx auth secret
AUTH_SECRET=""
ADMIN_EMAIL="nhacossfilipe@gmail.com"
# Only required when creating the owner via `npm run db:seed`; remove it from the deployment afterward.
# Use a unique 16-72 character password.
ADMIN_INITIAL_PASSWORD=""

# Shared rate limiting (required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Payment gateways — set these in the deployment environment, never in tracked JSON or client storage
ZENOFY_API_KEY=""
ZENOFY_PRODUCT_ID=""
ZENOFY_WEBHOOK_SECRET=""
E2PAYMENT_CLIENT_ID=""
E2PAYMENT_CLIENT_SECRET=""
ESCALEPAY_PUBLIC_KEY=""
ESCALEPAY_SECRET_KEY=""
ESCALEPAY_ACCOUNT_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:suporte@otterfy.co.mz"
